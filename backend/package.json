{
  "name": "telebot",
  "version": "1.0.0",
  "type": "module",
  "description": "Telegram multi-account promoter, live monitor, and DM automation dashboard",
  "scripts": {
    "assemble": "node scripts/assemble.mjs",
    "verify": "node scripts/assemble.mjs --verify",
    "dev": "node scripts/assemble.mjs && (node --experimental-strip-types --max-old-space-size=2048 --expose-gc server.build.ts || npx --yes tsx --expose-gc --max-old-space-size=2048 server.build.ts)",
    "start": "node scripts/assemble.mjs && npx --yes tsx --expose-gc --max-old-space-size=2048 server.build.ts",
    "build": "node scripts/assemble.mjs",
    "lint": "node -e 'console.log(\"Lint completed\")'"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "telegram": "^2.26.22",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
