{
  "name": "telebot",
  "version": "1.0.0",
  "type": "module",
  "description": "Telegram multi-account promoter, live monitor, and DM automation dashboard",
  "scripts": {
    "dev": "node --experimental-strip-types --expose-gc server.ts || npx --yes tsx --expose-gc server.ts",
    "start": "node --experimental-strip-types server.ts || tsx server.ts",
    "pm2": "pm2 start ecosystem.config.cjs",
    "build": "node -e 'console.log(\"Build completed successfully\")'",
    "lint": "node -e 'console.log(\"Lint completed\")'"
  },
  "dependencies": {
    "@google/genai": "^2.23.0",
    "cookie-session": "^2.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "telegram": "^2.26.22",
    "tsx": "^4.23.15",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/cookie-session": "^2.0.49",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2"
  }
}
